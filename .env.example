# Öffentliche Adresse der Website (für Links in Mails, Sitemap, Logo-Links)
SITE_URL=http://localhost:3100

# Ablage für vorläufige Anfragen und Logos (muss beschreibbar sein, nicht öffentlich)
STORAGE_DIR=./storage

# Lange Zufallszeichenkette (mind. 32 Zeichen), signiert Logo-Links. Erzeugen: openssl rand -base64 48
APP_SECRET=

# --- E-Mail (eigenes Firmenpostfach, z. B. IONOS) ---
# Ohne SMTP_HOST landen Mails in der Entwicklung in storage/outbox und in der Konsole.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="S&E Webstudio <hallo@se-webstudio.de>"
MAIL_REPLY_TO=
# Optional: Mail an dich bei jeder bestätigten Demo-Anfrage (bis die CRM-Benachrichtigung steht)
NOTIFY_EMAIL=

# --- CRM (agentur-crm → Verwaltung → Automatisierungen → Webhooks → Eingehend) ---
# Adresse und Geheimnis werden beim Anlegen des Webhooks einmalig angezeigt.
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=

# --- Calendly ---
# Link deines Ereignistyps, z. B. https://calendly.com/se-webstudio/30min (wird beim Build eingesetzt)
NEXT_PUBLIC_CALENDLY_URL=

# --- Aufräum-Job (/api/cron/aufraeumen) ---
CRON_SECRET=
